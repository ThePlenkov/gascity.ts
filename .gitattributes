# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized and converted
# to LF line endings on checkout.
*.c text
*.h text
*.cpp text
*.hpp text
*.cc text
*.cxx text
*.hxx text
*.java text
*.js text
*.jsx text
*.ts text
*.tsx text
*.json text
*.yaml text
*.yml text
*.toml text
*.md text
*.txt text
*.sh text eol=lf
*.py text eol=lf
*.rb text eol=lf
*.php text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.sass text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.svg text eol=lf

# Declare files that will always have CRLF line endings on checkout.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.bz2 binary
*.7z binary
*.rar binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.class binary
*.jar binary
*.war binary
*.ear binary
*.dll binary
*.so binary
*.dylib binary
*.exe binary
*.bin binary
