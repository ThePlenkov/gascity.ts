{
  "name": "gascity.ts",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "forwardPorts": [8080, 8372],
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "installOhMyZsh": true,
      "upgradePackages": true
    },
    "ghcr.io/devcontainers/features/node:2.1.0": {
      "version": "24"
    },
    "./features/homebrew": {
      "packages": ["gastownhall/gascity/gascity", "oven-sh/bun/bun"]
    },
    "./features/devin": {
      "version": "latest"
    },
    "./features/kilo": {},
    "./features/playwright": {
      "browsers": "chromium",
      "installMethod": "auto"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "github.copilot",
        "ms-vscode.vscode-typescript-next"
      ],
      "settings": {
        "mcp.servers": {
          "lovable": {
            "type": "http",
            "url": "https://mcp.lovable.dev"
          }
        }
      }
    }
  },
  "containerEnv": {
    "TERM": "xterm-256color",
    "HUSKY": "0"
  },
  "remoteUser": "vscode",
  "runArgs": ["--tty"],
  "postCreateCommand": "bun install && ./node_modules/.bin/playwright install chromium"
}

