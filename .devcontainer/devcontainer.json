{
  "name": "gascity.ts",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "forwardPorts": [8080, 8372],
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "installOhMyZsh": true,
      "upgradePackages": true
    },
    "ghcr.io/devcontainers/features/node:2.1.0": {
      "version": "24"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "github.copilot",
        "ms-vscode.vscode-typescript-next"
      ],
      "settings": {
        "mcp.servers": {
          "lovable": {
            "type": "http",
            "url": "https://mcp.lovable.dev"
          }
        }
      }
    }
  },
  "containerEnv": {
    "TERM": "xterm-256color"
  },
  "remoteUser": "vscode",
  "runArgs": ["--tty"],
  "postCreateCommand": "curl -fsSL https://bun.sh/install | bash && export PATH=\"$HOME/.bun/bin:$PATH\" && curl -fsSL https://cli.devin.ai/install.sh | bash && bun install && npx playwright install chromium"
}

